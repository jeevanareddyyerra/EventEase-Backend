# ==============================================================================
# EventEase Backend Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' (or export these variables in your shell) for local development or production.
# IMPORTANT: DO NOT commit actual passwords, tokens, or private keys to source control.

# Server Configuration
PORT=8080

# Database Configuration (MySQL)
DB_URL=jdbc:mysql://localhost:3306/eventease
DB_USERNAME=eventease_app
DB_PASSWORD=your_mysql_password_here

# JWT Security Configuration (minimum 256-bit / 32-byte secret for HMAC-SHA256)
# Example generation command on macOS/Linux: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_64_character_hex_string_here
JWT_EXPIRATION=86400000

# CORS Allowed Origins (comma-separated for multiple origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Gemini AI / RAG Configuration (Optional: required only if AI Assistant is enabled)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_ENABLED=true
